# Copy this file to .env and fill in your OWN OKX API key.
# Never commit .env - it's already in .gitignore.
#
# Create the key at https://www.okx.com/account/my-api?go-demo-trading=1 for a
# DEMO-TRADING key (recommended for your first run), or
# https://www.okx.com/account/my-api for a live key once you're ready.
#
# Permissions: enable READ and TRADE only. Never enable WITHDRAWAL.
# See docs/SAFETY.md before you do anything with a live key.

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
